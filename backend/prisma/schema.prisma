// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  picture   String?   // Google profile picture URL
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}